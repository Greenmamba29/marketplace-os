# BarrelHub Backend Environment Variables

# Application
APP_NAME=BarrelHub API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With

# Baserow
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_KEY=your-baserow-api-key
BASEROW_DATABASE_ID=123456

# Baserow Table IDs
BASEROW_USERS_TABLE_ID=100001
BASEROW_SUPPLIERS_TABLE_ID=100002
BASEROW_PRODUCTS_TABLE_ID=100003
BASEROW_BARREL_REGISTRY_TABLE_ID=100004
BASEROW_TTB_COMPLIANCE_TABLE_ID=100005
BASEROW_SENSORY_PROFILES_TABLE_ID=100006
BASEROW_MARKET_COMPS_TABLE_ID=100007
BASEROW_RFQ_TABLE_ID=100008
BASEROW_QUOTES_TABLE_ID=100009
BASEROW_ORDERS_TABLE_ID=100010
BASEROW_AUDIT_LOG_TABLE_ID=100011

# TTB API
TTB_API_URL=https://api.ttb.gov
TTB_API_KEY=your-ttb-api-key
TTB_VERIFY_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
STRIPE_PRICE_SELLER_MONTHLY=price_REPLACE
STRIPE_PRICE_BUYER_PRO=price_REPLACE
STRIPE_PRICE_RFQ_BOOST=price_REPLACE
FRONTEND_URL=http://localhost:3020
