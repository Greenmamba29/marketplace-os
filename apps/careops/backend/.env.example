# CareOps Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=CareOps API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Baserow Integration
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_TOKEN=your-baserow-api-token
BASEROW_DATABASE_ID=123456

# Baserow Table IDs
BASEROW_USERS_TABLE_ID=100001
BASEROW_CAREGIVERS_TABLE_ID=100002
BASEROW_CARE_PLANS_TABLE_ID=100003
BASEROW_SCHEDULES_TABLE_ID=100004
BASEROW_BG_CHECKS_TABLE_ID=100005
BASEROW_PAYER_AUTHS_TABLE_ID=100006

# Background Check Providers (Optional)
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
STERLING_API_KEY=
STERLING_WEBHOOK_SECRET=

# Email/SMS Notifications (Optional)
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
STRIPE_PRICE_SELLER_MONTHLY=price_REPLACE
STRIPE_PRICE_BUYER_PRO=price_REPLACE
STRIPE_PRICE_RFQ_BOOST=price_REPLACE
FRONTEND_URL=http://localhost:3012
