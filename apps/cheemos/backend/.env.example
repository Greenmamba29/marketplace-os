# ChemOS Backend Environment Variables

# Application
DEBUG=true
ENVIRONMENT=development
APP_NAME=ChemOS API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,https://cheemos.io

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/cheemos

# Redis
REDIS_URL=redis://localhost:6379/0

# Baserow (Required)
BASEROW_API_URL=https://api.baserow.io
BASEROW_TOKEN=your_baserow_token_here
BASEROW_DATABASE_ID=0

# Saleor (Optional)
SALEOR_API_URL=
SALEOR_TOKEN=

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
STRIPE_PRICE_SELLER_MONTHLY=price_REPLACE
STRIPE_PRICE_BUYER_PRO=price_REPLACE
STRIPE_PRICE_RFQ_BOOST=price_REPLACE
FRONTEND_URL=http://localhost:3002
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Sentry (Optional)
SENTRY_DSN=

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@cheemos.io

# Storage (Optional)
STORAGE_BUCKET=cheemos-uploads
STORAGE_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
