# LabSource Backend Environment Variables

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=LabSource API
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=change-me-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labsource

# Redis
REDIS_URL=redis://localhost:6379/0

# Baserow Integration
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=your-baserow-api-token
BASEROW_DATABASE_ID=12345

# Saleor Integration
SALEOR_URL=https://your-saleor-instance.com/graphql/
SALEOR_TOKEN=your-saleor-app-token
SALEOR_CHANNEL=default-channel

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@labsource.io

# AWS S3 Storage
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=labsource-documents
AWS_REGION=us-east-1

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
STRIPE_PRICE_SELLER_MONTHLY=price_REPLACE
STRIPE_PRICE_BUYER_PRO=price_REPLACE
STRIPE_PRICE_RFQ_BOOST=price_REPLACE
FRONTEND_URL=http://localhost:3010

# Sentry Error Tracking
SENTRY_DSN=https://...@sentry.io/...

# CLIA Configuration
CLIA_VALIDATION_ENABLED=true

# Cold Chain
COLD_CHAIN_ALERT_THRESHOLD_MINUTES=15
TEMP_EXCURSION_TOLERANCE_C=2.0
