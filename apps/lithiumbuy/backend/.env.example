# LithiumBuy Backend Environment Variables

# Application
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Baserow
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=your-baserow-api-token
BASEROW_DATABASE_ID=your-database-id

# Baserow Table IDs
USERS_TABLE_ID=0
SUPPLIERS_TABLE_ID=0
PRODUCTS_TABLE_ID=0
RFQ_TABLE_ID=0
QUOTES_TABLE_ID=0
ORDERS_TABLE_ID=0
CONTRACTS_TABLE_ID=0
SPOT_PRICES_TABLE_ID=0
MINES_TABLE_ID=0
ALERTS_TABLE_ID=0

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
STRIPE_PRICE_SELLER_MONTHLY=price_REPLACE
STRIPE_PRICE_BUYER_PRO=price_REPLACE
STRIPE_PRICE_RFQ_BOOST=price_REPLACE
FRONTEND_URL=http://localhost:3006

# External APIs (Optional)
ACCIO_API_URL=
ACCIO_API_KEY=
