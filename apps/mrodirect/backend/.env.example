# MRODirect Backend Environment Configuration

# Application
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,https://mrodirect.io

# Baserow
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=your-baserow-api-token
BASEROW_DATABASE_ID=12345

# Baserow Table IDs (optional - will use defaults if not set)
BASEROW_USERS_TABLE_ID=100
BASEROW_SUPPLIERS_TABLE_ID=101
BASEROW_PARTS_TABLE_ID=102
BASEROW_MACHINES_TABLE_ID=103
BASEROW_RFQ_TABLE_ID=104
BASEROW_QUOTES_TABLE_ID=105
BASEROW_ORDERS_TABLE_ID=106
BASEROW_CONTRACTS_TABLE_ID=107

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET
STRIPE_PRICE_SELLER_MONTHLY=price_REPLACE
STRIPE_PRICE_BUYER_PRO=price_REPLACE
STRIPE_PRICE_RFQ_BOOST=price_REPLACE
FRONTEND_URL=http://localhost:3001
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@mrodirect.io
